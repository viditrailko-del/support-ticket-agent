{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ticket-review",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8766", "--bind", "127.0.0.1", "--directory", "eval/tickets"],
      "port": 8766
